/*
 * Xiaomi Raphael PMIC thermistors.
 *
 * Downstream Raphael identifies these board connections on PM8150,
 * PM8150B and PM8150L. The ADC5 100K_PU channel IDs select the PMIC's
 * internal 100 kOhm pull-up and its thermistor temperature scaling.
 *
 * Keep each path disabled until the charging and thermal policies that
 * consume it have been established. Battery temperature and JEITA are
 * handled separately from these board thermistors.
 */

#include <dt-bindings/iio/qcom,spmi-vadc.h>

/* PM8150B THM2 is the SMB1390 die output, defined without a pull-up. */
&pm8150b_adc {
	raphael_wp_therm: channel@4d {
		reg = <ADC5_AMUX_THM1_100K_PU>;
		qcom,ratiometric;
		qcom,hw-settle-time = <200>;
		qcom,pre-scaling = <1 1>;
		label = "wp_therm";
		status = "disabled";
	};

	raphael_conn_therm: channel@4f {
		reg = <ADC5_AMUX_THM3_100K_PU>;
		qcom,ratiometric;
		qcom,hw-settle-time = <200>;
		qcom,pre-scaling = <1 1>;
		label = "conn_therm";
		status = "disabled";
	};
};

&pm8150b_adc_tm {
	wp-therm@0 {
		reg = <0>;
		io-channels = <&pm8150b_adc ADC5_AMUX_THM1_100K_PU>;
		qcom,ratiometric;
		qcom,hw-settle-time-us = <200>;
		qcom,pre-scaling = <1 1>;
		status = "disabled";
	};

	conn-therm@1 {
		reg = <1>;
		io-channels = <&pm8150b_adc ADC5_AMUX_THM3_100K_PU>;
		qcom,ratiometric;
		qcom,hw-settle-time-us = <200>;
		qcom,pre-scaling = <1 1>;
		status = "disabled";
	};
};

&pm8150_adc {
	raphael_xo_therm: channel@4c {
		reg = <ADC5_XO_THERM_100K_PU>;
		qcom,ratiometric;
		qcom,hw-settle-time = <200>;
		qcom,pre-scaling = <1 1>;
		label = "xo_therm";
		status = "disabled";
	};

	raphael_quiet_therm: channel@4d {
		reg = <ADC5_AMUX_THM1_100K_PU>;
		qcom,ratiometric;
		qcom,hw-settle-time = <200>;
		qcom,pre-scaling = <1 1>;
		label = "quiet_therm";
		status = "disabled";
