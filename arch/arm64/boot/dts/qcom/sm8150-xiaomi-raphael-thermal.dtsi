	raphael_pa_therm0: channel@4e {
		reg = <ADC5_AMUX_THM2_100K_PU>;
		qcom,ratiometric;
		qcom,hw-settle-time = <200>;
		qcom,pre-scaling = <1 1>;
		label = "pa_therm0";
		status = "disabled";
	};
};

&pm8150_adc_tm {
	xo-therm@0 {
		reg = <0>;
		io-channels = <&pm8150_adc ADC5_XO_THERM_100K_PU>;
		qcom,ratiometric;
		qcom,hw-settle-time-us = <200>;
		qcom,pre-scaling = <1 1>;
		status = "disabled";
	};

	quiet-therm@1 {
		reg = <1>;
		io-channels = <&pm8150_adc ADC5_AMUX_THM1_100K_PU>;
		qcom,ratiometric;
		qcom,hw-settle-time-us = <200>;
		qcom,pre-scaling = <1 1>;
		status = "disabled";
	};

	pa-therm0@2 {
		reg = <2>;
		io-channels = <&pm8150_adc ADC5_AMUX_THM2_100K_PU>;
		qcom,ratiometric;
		qcom,hw-settle-time-us = <200>;
		qcom,pre-scaling = <1 1>;
		status = "disabled";
	};
};

&pm8150l_adc {
	raphael_camera_flash_therm: channel@4d {
		reg = <ADC5_AMUX_THM1_100K_PU>;
